{
  "expo": {
    "name": "Bakery Catalog",
    "slug": "bakery-catalog",
    "scheme": "bakerycatalog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.bakerycatalog"
    },
    "android": {
      "package": "com.example.bakerycatalog",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can add product images.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to photograph your products.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
